{
  "name": "@dogfight/shared",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Deterministic simulation, protocol and codecs shared by client and server",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "determinism": "node -e \"import('./src/determinism.ts').then(m => m.runScenario()).then(r => console.log(JSON.stringify(r)))\"",
    "typecheck": "tsc --noEmit -p .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
