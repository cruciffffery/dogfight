{
  "name": "dogfight",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Real-time multiplayer browser game (semester project)",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test --workspaces",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit -p e2e",
    "test:coverage": "npm run test:coverage -w shared",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.20.5",
    "@playwright/test": "1.56.0",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.10.2"
  }
}
