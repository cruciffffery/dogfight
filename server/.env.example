# Скопіюйте в server/.env (він у .gitignore). У продакшні — змінні середовища платформи,
# секрети — у її сховищі секретів (fly secrets set ...), НІКОЛИ не в образі й не в git.
PORT=8080
HOST=0.0.0.0
LOG_DIR=./logs
LOG_LEVEL=info
MAX_ROOMS=50
MAX_PLAYERS_PER_ROOM=8
# Дозволені Origin для WebSocket (через кому). Порожньо = лише той самий хост, що й сторінка.
ALLOWED_ORIGINS=
MAX_CONNECTIONS_PER_IP=8
CONNECT_BURST_PER_IP=20
CONNECT_RATE_PER_IP=2
# 1 — сервер за проксі (Fly, nginx): IP клієнта з X-Forwarded-For / Fly-Client-IP
TRUST_PROXY=0
# Версія збірки; у Docker задається build-arg APP_VERSION
APP_VERSION=dev
# Увімкнути /api/slow (демонстрація блокування event loop)
ENABLE_DEBUG_ROUTES=0
